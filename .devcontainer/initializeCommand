#!/bin/bash

# custom initialization goes here - runs outside of the dev container
# just before the container is launched but after the container is created

echo "initializeCommand for devcontainerID ${1}"
set -xe

# create the host folders that devcontainer.json bind mounts, so that the
# container runtime does not create them root owned:
#   terminal-config - the user's terminal config, mounted at /user-terminal-config
#   .cache/uv       - a cross container cache for uv
mkdir -p ${HOME}/.config/terminal-config ${HOME}/.cache/uv
# make a folder for auto-generated opi screens
mkdir -p ./opi/auto-generated


# The developer image that CI publishes; devcontainer.json names the same one.
# Pull it so that it is up to date; when it cannot be pulled use the local image
# of that name, or build one if there is none. Set EC_LOCAL_BUILD to 1, true or
# yes (in any case) to skip the pull and build the image from this folder; any
# other value, or none, leaves that off.
image="ghcr.io/epics-containers/ioc-pmac-developer:latest"

# prefer docker but use podman if USE_PODMAN is set, as ./build does
if docker version &> /dev/null && [[ -z $USE_PODMAN ]] ; then
    docker=docker
elif command -v podman &> /dev/null ; then
    docker=podman
else
    echo "neither docker nor podman is available to pull or build ${image}"
    exit 1
fi

# make sure new clones get their submodule ibek-support, as ./build does
if [ ! -d ibek-support/_global ] ; then git submodule update --init ; fi

case $(echo "${EC_LOCAL_BUILD}" | tr '[:upper:]' '[:lower:]') in
    1|true|yes) local_build=true ;;
    *) local_build= ;;
esac

if [[ -n ${local_build} ]] ; then
    echo "EC_LOCAL_BUILD is ${EC_LOCAL_BUILD}, building ${image}"
    TAG=${image} TARGET=developer ./build
elif $docker pull "${image}" ; then
    echo "pulled ${image}"
elif $docker image inspect "${image}" &> /dev/null ; then
    echo "could not pull ${image}, using the local image"
else
    echo "could not pull ${image} and there is no local image, building it"
    TAG=${image} TARGET=developer ./build
fi
